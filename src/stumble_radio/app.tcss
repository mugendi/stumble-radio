Screen { background: #10161e; color: #dfe7ef; }
#masthead { width: 100%; height: 4; padding: 1 2 1 2; }
#masthead-brand { width: 1fr; height: 2; }
#logo { width: 1fr; height: 1; color: #68ddc4; text-style: bold; }
#tagline { height: 1; color: #8a9bac; }
#destination-line { width: auto; max-width: 40%; height: 2; color: #eebc78; content-align: right top; text-align: right; }
#transport { width: 100%; height: auto; min-height: 3; padding: 0 2; margin-bottom: 1; }
#transport .media-control { width: 6; min-width: 6; padding: 0; text-style: bold; }
#transport-primary { width: auto; height: 3; }
#transport-extra { width: 1fr; height: 3; }
#transport-extra .transport-spacer { width: 1fr; height: 3; }
#audio-meter { color: #68ddc4; content-align: center middle; }
#info-line { width: 100%; height: 1; padding: 0 2; margin-bottom: 1; }
#podmoro-line { width: auto; max-width: 50%; height: 1; color: #eebc78; text-align: right; }
#discovery-line { width: 1fr; height: 1; color: #68ddc4; }
Button { min-width: 9; height: 3; text-wrap: nowrap; text-overflow: ellipsis; margin: 0 1 0 0; border: solid #283748; background: #1a2633; }
Button:hover { background: #263b4c; }
Button.-primary { color: #10161e; background: #68ddc4; border: solid #68ddc4; text-style: bold; }
Button.-primary:hover { background: #98eedb; }
#body { width: 100%; height: 1fr; padding: 0 2; }
#sidebar { width: 28; padding: 0 1 0 0; }
#library { margin-bottom: 1; }
.sync-caption { color: #68ddc4; text-style: bold; }
#sync-by { width: 1fr; margin-bottom: 1; }
#detail { height: 1fr; color: #aab9c8; overflow-y: auto; }
#timer { height: 2; color: #eebc78; }
#browser { width: 1fr; }
#masthead-brand, #browser, #station-info, #transport-extra { min-width: 0; }
#podmoro, #cycle-library, #clear-filters { margin-right: 0; }
#playing-station, #status-line, #discovery-line, #podmoro-line, #destination-line, #tagline, #logo, #active-filters {
    text-wrap: nowrap; text-overflow: ellipsis;
}
#search-toolbar { height: 3; margin-bottom: 1; }
#quick-search { height: 3; width: 1fr; }
#clear-filters { width: 11; min-width: 11; padding: 0; margin: 0 0 0 1; }
#active-filters { height: 1; color: #eebc78; margin-bottom: 1; }
#query-error { height: auto; max-height: 3; overflow-y: auto; color: #f49d9d; margin-bottom: 1; }
#stations { width: 1fr; height: 1fr; min-height: 1; background: #10161e; border: none; scrollbar-gutter: stable; scrollbar-size: 1 1; }
DataTable > .datatable--header { background: #1a2633; color: #9aaec1; text-style: bold; }
DataTable > .datatable--cursor { background: #24493f; color: #effff9; }
DataTable > .datatable--odd-row { background: #141e28; }
#table-toolbar { height: 3; }
#playing-station { display: none; width: 1fr; height: 1; color: #68ddc4; text-style: bold; }
#station-info { width: 1fr; height: 2; margin-top: 1; margin-right: 1; }
#table-actions { width: auto; height: 3; }
#status-line { height: 1; color: #8a9bac; }
Footer { padding: 0 2; background: #10161e; }
Footer > .footer--key { background: #263b4c; color: #68ddc4; }
Input { background: #141e28; border: solid #283748; }
Input:focus { border: solid #68ddc4; }
TextArea { background: #141e28; border: tall #283748; }
TextArea:focus { border: tall #68ddc4; }
Select { height: 3; }
SelectCurrent { border: solid #283748; }
Select:focus > SelectCurrent { border: solid #68ddc4; }
ModalScreen { align: center middle; background: #000000 65%; }
ModalScreen Label { width: 1fr; text-wrap: wrap; }
ModalScreen Checkbox { width: 1fr; height: auto; text-wrap: wrap; }
#search-dialog { width: 76; max-width: 95%; height: 90%; padding: 1 2; border: round #68ddc4; background: #10161e; }
#confirm-dialog { width: 60; max-width: 95%; height: auto; padding: 1 2; border: round #68ddc4; background: #10161e; }
.dialog-title { height: 2; text-style: bold; color: #68ddc4; }
.muted { height: auto; color: #8a9bac; margin-bottom: 1; }
#search-fields { height: 1fr; }
#filter-grid { layout: grid; grid-size: 2; grid-columns: 23 1fr; grid-rows: 3; height: auto; }
#filter-grid Label { content-align: left middle; height: 3; }
#search-error { height: auto; color: #f49d9d; }
.dialog-actions { height: 3; margin-top: 1; }
#equalizer-dialog { width: 76; max-width: 95%; height: 95%; max-height: 36; padding: 1 2; border: round #68ddc4; background: #10161e; }
#eq-options { height: 3; margin-bottom: 1; }
#eq-options Checkbox { height: 3; text-wrap: nowrap; padding: 0; }
#eq-bypass { width: 16; }
#eq-auto-level { width: 20; }
#eq-preset { width: 1fr; }
#eq-fields { height: 1fr; min-height: 0; margin-bottom: 1; }
.eq-row { height: 3; }
.eq-row Label { width: 18; height: 3; content-align: left middle; }
.eq-row Button { width: 5; min-width: 5; padding: 0; margin: 0; }
.eq-row Input { width: 10; margin: 0 1; }
.eq-unit { width: 5; height: 3; content-align: left middle; }
#eq-gain-row Label { color: #eebc78; }
#eq-error { height: auto; color: #f49d9d; }
#station-notes-dialog { width: 80; max-width: 95%; height: 90%; padding: 1 2; border: round #68ddc4; background: #10161e; }
#notes-station { height: auto; max-height: 3; text-style: bold; }
#notes-station-details { height: auto; max-height: 2; color: #8a9bac; margin-bottom: 1; }
#station-notes-dialog Label { height: auto; }
#station-notes-dialog .dialog-title { height: 2; }
#station-notes-text { height: 1fr; min-height: 3; margin-bottom: 1; }
#station-notes-tags { margin-bottom: 1; }
#station-notes-error { height: auto; color: #f49d9d; }
#station-notes-dialog .dialog-actions { margin-top: 0; }
#station-notes-dialog .muted { margin-bottom: 0; }
#picker-dialog { width: 72; max-width: 95%; height: 70%; padding: 1 2; border: round #68ddc4; background: #10161e; }
#picker-options { height: 1fr; margin: 1 0; background: #10161e; }
#help-dialog { width: 76; max-width: 95%; height: auto; max-height: 95%; overflow-y: auto; padding: 1 2; border: round #68ddc4; background: #10161e; }
#help-dialog Static { height: auto; margin-bottom: 1; }
#settings-dialog, #journal-dialog { width: 88; max-width: 95%; height: 85%; padding: 1 2; border: round #68ddc4; background: #10161e; }
#settings-dialog Label { height: auto; }
#settings-dialog Input { margin-bottom: 1; }
#settings-error, #sleep-error { height: auto; color: #f49d9d; }
#sleep-dialog { width: 72; max-width: 95%; height: auto; padding: 1 2; border: round #68ddc4; background: #10161e; }
#sleep-dialog Label { height: auto; margin-bottom: 1; }
#sleep-dialog Input { margin-bottom: 1; }
#journal-dialog Static { height: auto; margin-bottom: 1; }
#last-play-dialog { width: 120; max-width: 95%; height: 85%; padding: 1 2; border: round #68ddc4; background: #10161e; }
#last-play-results { height: 1fr; background: #10161e; }
#last-play-status { height: auto; color: #8a9bac; margin-top: 1; }
.journal-heading { height: 2; margin-top: 1; color: #68ddc4; text-style: bold; }
#pomodoro-dialog { width: 104; max-width: 95%; height: 94%; padding: 1 2; border: round #68ddc4; background: #10161e; }
#pomodoro-dialog TabbedContent, #pomodoro-dialog ContentSwitcher { height: 1fr; }
#pomodoro-dialog TabPane { height: 1fr; padding: 0; }
#pomodoro-dialog VerticalScroll { height: 1fr; }
#pomodoro-dialog Button { min-width: 0; width: 1fr; margin: 0; padding: 0 1; }
#pomodoro-dialog Label { height: auto; }
#pomo-live { height: auto; min-height: 3; margin-bottom: 1; }
.pomo-actions { grid-size: 3; grid-columns: 1fr 1fr 1fr; grid-rows: 3; grid-gutter: 0 1; height: auto; margin: 1 0; }
#pomo-session-actions { grid-size: 4; grid-columns: 1fr 1fr 1fr 1fr; margin: 0; }
.pomo-fields { grid-size: 2; grid-columns: 26 1fr; grid-rows: 3; height: auto; }
.pomo-fields Label { height: 3; content-align: left middle; }
.pomo-section { height: 2; margin-top: 1; color: #68ddc4; }
#pomo-reminders, #pomo-clips-table { height: 8; min-height: 4; background: #10161e; margin: 1 0; }
#pomo-feedback { height: auto; max-height: 3; color: #eebc78; margin: 0; }
#pomo-close { height: 3; }
.narrow #sidebar { display: none; }
.narrow #masthead { height: 4; padding: 1 1 1 1; }
.narrow #info-line { padding: 0 1; margin: 0; height: auto; layout: vertical; }
.narrow #podmoro-line { width: 100%; max-width: 100%; text-align: left; }
.narrow #pomo-session-hint { display: none; }
.narrow #pomo-live { margin-bottom: 0; }
.narrow #search-toolbar { margin-bottom: 0; }
.narrow #active-filters { margin-bottom: 0; }
.narrow #query-error { margin-bottom: 0; }
.stacked #table-toolbar { height: 5; layout: vertical; }
.stacked #table-actions { dock: top; width: 100%; align-horizontal: right; }
.stacked #station-info { margin: 0; }
#table-actions Button { min-width: 8; padding: 0 1; }
.narrow #body { padding: 0 1; }
.narrow #transport { padding: 0 1; height: 3; margin-bottom: 0; }
.narrow #transport-extra { width: 1fr; }
.narrow .pomo-fields { grid-columns: 22 1fr; }
.narrow #transport Button { width: 9; min-width: 0; padding: 0; }
.narrow #transport Button.media-control { width: 5; min-width: 5; padding: 0; }
.narrow Footer { padding: 0 1; }
.narrow #search { display: none; }
.compact #picker, .compact #audio-meter, .compact #destination-line { display: none; }
.compact #transport-extra { align-horizontal: right; }
.tiny #record { display: none; }
.tiny #transport Button.media-control { width: 5; min-width: 5; }
.compact #table-actions Button { width: 10; min-width: 10; padding: 0; }
.compact #table-actions #page-back, .compact #table-actions #page-next { width: 5; min-width: 5; }
.short #masthead { height: 2; padding: 0 1 1 1; }
.short #masthead-brand { height: 1; }
.short #tagline { display: none; }
.short #transport { margin-bottom: 0; }
.short #info-line { margin-bottom: 0; }
.short #search-toolbar { margin-bottom: 0; }
.short #active-filters, .short #query-error { margin-bottom: 0; }

/* Dialog fields scroll; titles, validation, and action buttons stay reachable. */
.dialog-actions Button { min-width: 0; width: 1fr; padding: 0; margin: 0; }
#sleep-dialog { max-height: 95%; overflow-y: auto; }
.compact #search-dialog, .compact #equalizer-dialog, .compact #station-notes-dialog,
.compact #picker-dialog, .compact #help-dialog, .compact #settings-dialog,
.compact #sleep-dialog, .compact #journal-dialog, .compact #last-play-dialog,
.compact #pomodoro-dialog { width: 100%; max-width: 100%; padding: 0 1; }
.compact #filter-grid, .compact .pomo-fields { grid-size: 1; grid-columns: 1fr; grid-rows: auto; }
.compact #filter-grid Label, .compact .pomo-fields Label { height: auto; }
.compact #eq-options { layout: grid; grid-size: 2; grid-columns: 1fr 1fr; grid-rows: 3; height: 6; }
.compact #eq-preset { column-span: 2; }
.compact #eq-bypass, .compact #eq-auto-level { width: 1fr; }
.compact .eq-row Label { width: 12; }
.compact .eq-row Button { width: 4; min-width: 4; }
.compact .eq-row Input { width: 8; }
.compact .eq-unit { width: 3; }
.compact #equalizer-dialog .muted, .compact #station-notes-dialog .muted { display: none; }
.compact #notes-station { max-height: 2; }
.compact #notes-station-details { max-height: 1; text-wrap: nowrap; text-overflow: ellipsis; }
.compact #pomo-session-actions, .compact .pomo-actions { grid-size: 2; grid-columns: 1fr 1fr; }
.compact #last-play-dialog { height: 95%; }
.compact #last-play-dialog .muted { display: none; }
.compact #last-play-status { max-height: 2; }
.compact #last-play-dialog .dialog-actions { layout: grid; grid-size: 2; grid-columns: 1fr 1fr; grid-rows: 3; height: 6; }
